# ==============================================================================
# CodexAccountSwitcher 環境設定範例檔 (.env.example)
# ==============================================================================
# 預設情況下，工具自動偵測當前 Windows 使用者環境，無需特別設定。
# 若需要自訂路徑或測試環境，可透過下列環境變數覆寫：

# Codex 設定與憑證主目錄（預設為 %USERPROFILE%\.codex）
CODEX_HOME=

# 切換器本機加密備份目錄（預設為 %LOCALAPPDATA%\CodexAccountSwitcher）
CODEX_SWITCHER_STORE=
